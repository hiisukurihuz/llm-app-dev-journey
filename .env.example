# 首次运行前配置环境：

# 复制本文件为 .env，再填入自己的密钥
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env

# DeepSeek 开放平台密钥  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key

# 火山方舟（Ark）密钥  https://console.volcengine.com/ark
VOLC_API_KEY=ark-your-key

# 以下可选：
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  # 火山方舟 API 基础地址，chat 和 embedding 都走它
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ARK_CHAT_MODEL=deepseek-v4-pro-ga-260813   #注意：不同时期注册用户开通模型权限名称不同，不通用
# ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215   #火山Embedding模型名称
