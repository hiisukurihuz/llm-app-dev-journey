# 复制本文件为 .env，再填入自己的密钥
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
# .env 已被 .gitignore 排除，永远不会进入仓库

# DeepSeek 开放平台密钥  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 火山方舟（Ark）密钥  https://console.volcengine.com/ark
VOLC_API_KEY=ark-your-key-here

# 以下可选，不填就用代码里的默认值
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ARK_CHAT_MODEL=deepseek-v4-pro-ga-260813
# ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
